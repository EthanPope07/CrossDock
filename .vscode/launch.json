{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run CrossDock extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/src/vscode-ext"],
      "outFiles": ["${workspaceFolder}/src/vscode-ext/dist/**/*.js"],
      "preLaunchTask": "build crossdock extension"
    }
  ]
}
